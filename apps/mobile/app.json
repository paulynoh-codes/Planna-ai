{
  "expo": {
    "name": "Planna",
    "slug": "planna",
    "scheme": "planna",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.planna.app"
    },
    "android": {
      "package": "ai.planna.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F5F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
